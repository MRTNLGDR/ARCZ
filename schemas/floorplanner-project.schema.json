{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcz://schemas/floorplanner-project.schema.json",
  "title": "Floorplanner Project",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "region_id",
    "context_hash",
    "current_revision",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "arcz_project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "region_id": {
      "type": "string"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context": {
      "$ref": "modeling-context-package.schema.json"
    },
    "current_revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "READY_WITHOUT_SCENE",
        "READY",
        "READ_ONLY",
        "CORRUPT"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
