{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcz://schemas/local-worker-manifest.schema.json",
  "title": "ARCZ local command worker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "command", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "description": {"type": "string"},
    "network_mode": {"const": "offline_strict"},
    "produces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
