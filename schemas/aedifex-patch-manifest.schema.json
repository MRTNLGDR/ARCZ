{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcz://schemas/aedifex-patch-manifest.schema.json",
  "title": "ARCZ controlled Aedifex overlay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "upstream_commit", "strategy", "policy", "patches"],
  "properties": {
    "schema_version": { "const": 4 },
    "upstream_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "strategy": { "const": "AEDIFEX_BUILDING_AUTHORING_KERNEL_INSIDE_ARCZ_WORLD_CORE" },
    "policy": { "type": "string", "minLength": 40 },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "destination", "purpose", "authority", "reversible", "test_gate"],
        "properties": {
          "id": { "type": "string", "pattern": "^ARCAED-[0-9]{3}$" },
          "kind": { "type": "string", "minLength": 2 },
          "source": { "type": "string", "minLength": 2 },
          "destination": { "type": "string", "minLength": 2 },
          "purpose": { "type": "string", "minLength": 20 },
          "authority": { "enum": ["ARCZ_WORLD", "AEDIFEX_AUTHORING", "SHARED_BRIDGE", "BUILD_GOVERNANCE"] },
          "reversible": { "const": true },
          "test_gate": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
        }
      }
    }
  }
}
