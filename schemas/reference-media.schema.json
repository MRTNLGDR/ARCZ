{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcz://schemas/reference-media.schema.json",
  "title": "Reference Media",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_hash",
    "original_name",
    "stored_path",
    "mime",
    "category",
    "bytes",
    "roles",
    "license",
    "provenance",
    "metadata",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_name": {
      "type": "string",
      "minLength": 1
    },
    "stored_path": {
      "type": "string",
      "minLength": 1
    },
    "mime": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "document",
        "model3d",
        "bim",
        "cad",
        "pointcloud",
        "geodata",
        "dataset",
        "lighting"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "object",
      "required": [
        "id"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
