{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcz://schemas/region-request.schema.json",
  "title": "Region Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "region_id",
    "bbox_wgs84",
    "polygon_wgs84",
    "focus",
    "scale",
    "requested_radius_m",
    "sources"
  ],
  "properties": {
    "region_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bbox_wgs84": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85.0511287798066,
          "maximum": 85.0511287798066
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85.0511287798066,
          "maximum": 85.0511287798066
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "polygon_wgs84": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -85.0511287798066,
            "maximum": 85.0511287798066
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 0,
      "maxItems": 50000
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -85.0511287798066,
          "maximum": 85.0511287798066
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "scale": {
      "enum": [
        "mundo",
        "continente",
        "pais",
        "estado",
        "cidade",
        "bairro",
        "quarteirao",
        "endereco",
        "lote",
        "poligono_manual"
      ]
    },
    "requested_radius_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000000
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osm",
        "overture",
        "dem",
        "imagery",
        "street"
      ],
      "properties": {
        "osm": {
          "type": "boolean"
        },
        "overture": {
          "type": "boolean"
        },
        "dem": {
          "type": "boolean"
        },
        "imagery": {
          "type": "boolean"
        },
        "street": {
          "type": "boolean"
        }
      }
    },
    "generation_epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
