{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcz://schemas/region-context.schema.json",
  "title": "Region Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "region_id",
    "crs_work",
    "origin_wgs84",
    "terrain",
    "urban",
    "environment",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "region_id": {
      "type": "string",
      "minLength": 1
    },
    "crs_work": {
      "const": "ENU_LOCAL"
    },
    "origin_wgs84": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85.0511287798066,
          "maximum": 85.0511287798066
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_m",
        "max_m",
        "mean_slope_deg",
        "slope_classes",
        "confidence"
      ],
      "properties": {
        "min_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean_slope_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 90
        },
        "slope_classes": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vertical_error_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "urban": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "density",
        "block_pattern",
        "road_hierarchy",
        "building_height_distribution",
        "landuse_distribution"
      ],
      "properties": {
        "density": {
          "enum": [
            "unknown",
            "very_low",
            "low",
            "medium",
            "high",
            "very_high"
          ]
        },
        "block_pattern": {
          "type": "string"
        },
        "road_hierarchy": {
          "type": "object"
        },
        "building_height_distribution": {
          "type": "object"
        },
        "landuse_distribution": {
          "type": "object"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biome",
        "climate_profile",
        "soil_profile"
      ],
      "properties": {
        "biome": {
          "type": "string"
        },
        "climate_profile": {
          "type": "string"
        },
        "soil_profile": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "source",
          "source_ref",
          "confidence",
          "timestamp"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
