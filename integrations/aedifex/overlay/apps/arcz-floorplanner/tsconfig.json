{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/viewer"
    },
    {
      "path": "../../packages/mcp"
    },
    {
      "path": "../../packages/ifc-converter"
    },
    {
      "path": "../../packages/nodes"
    }
  ]
}
