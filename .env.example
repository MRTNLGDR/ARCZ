# ARCZ Earth + Aedifex Global — configuração local segura
ARCZ_NETWORK_MODE=offline_strict
ARCZ_PORT=8123
ARCZ_SEM_NAVEGADOR=0
ARCZ_JOB_WORKERS=1

# Acervo local opcional
ARCZ_BANCO=D:\AVANGARD-ASSETS

# Executáveis/modelos locais opcionais; nunca coloque tokens de provedor aqui.
ARCZ_BLENDER=
ARCZ_LOCAL_MODEL_ROOT=

# O token do bridge Aedifex é efêmero e gerado pelo runtime. Não persista valor.
# O runtime injeta a credencial efêmera em memória; não existe campo persistível neste arquivo.
